<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentMaster.master.cs" Inherits="StudentManagementSystem.StudentMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>UniTrack</title>
    <link href="/Styles/output.css?v=2" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.7.2/css/all.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <asp:ContentPlaceHolder ID="NavigationBar" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="bg-white font-roboto">
    <form id="form1" runat="server" enctype="multipart/form-data">   <!-- 👈 ADD THIS -->
        <div class="sidebar fixed top-0 left-0 flex flex-col h-screen bg-white shadow-lg">
            <!-- Profile Section - Fixed to fit collapsed sidebar -->
            <div class="mt-6">
                <div class="flex items-center p-4 sidebar-collapsed-padding border-b border-gray-100">
                    <!-- Avatar - 48px fits perfectly in collapsed sidebar -->
                    <div class="profile-avatar w-12 h-12 min-w-[48px] min-h-[48px] max-w-[48px] max-h-[48px] rounded-full border-2 border-gray-200 overflow-hidden bg-gray-100 flex-shrink-0 shadow-sm">
                        <asp:Image ID="ProfilePicture" runat="server" CssClass="w-full h-full object-cover" />
                    </div>
                    <!-- Clickable profile details -->
                    <a href="/Student/StudentProfile/StudentProfile.aspx" class="profile-details ml-3 overflow-hidden">
                        <p class="text-xs text-gray-400 font-medium tracking-wide uppercase">Student</p>
                        <div class="profile-info-row mt-0.5">
                            <asp:Label ID="lblStudentName" runat="server" CssClass="student-name text-base font-semibold text-gray-800 truncate"></asp:Label>
                            <i class="fa-solid fa-angle-down dropdown-icon text-gray-500 text-sm"></i>
                        </div>
                    </a>
                </div>
            </div>
            <!-- Navigation Links -->
            <div class="flex flex-col gap-2 p-4 text-[18px]">
                <a id="lnkDashboard" runat="server" href="/Student/StudentDashboard/StudentDashboard.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-house w-5"></i><span class="menu-text">Dashboard</span>
                </a>
                <a id="lnkCourse" runat="server" href="/Student/StudentCourse/StudentCourse.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-graduation-cap w-5"></i><span class="menu-text">My Courses</span>
                </a>
                <a id="lnkAcademic" runat="server" href="/Student/StudentAcademicResult/StudentAcademicResult.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-book-open w-5"></i><span class="menu-text">Academic Results</span>
                </a>
                <a id="lnkAttendance" runat="server" href="/Student/StudentAttendance/StudentAttendance.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-calendar-check w-5"></i><span class="menu-text">My Attendance</span>
                </a>
                <a id="lnkEnrollment" runat="server" href="/Student/StudentCourseEnrol/StudentCourseEnrol.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-pen-to-square w-5"></i><span class="menu-text">Course Enrollment</span>
                </a>
            </div>
            <!-- Bottom Links -->
            <div class="mt-auto p-4 mb-2 text-[18px]">
                <a href="/Login.aspx" class="sidebar-link flex items-center gap-4 px-4 py-2 text-black transition">
                    <i class="fa-solid fa-right-from-bracket w-5"></i><span class="menu-text">Log out</span>
                </a>
            </div>
        </div>
        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>