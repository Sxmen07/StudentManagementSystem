<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentMaster.master.cs" Inherits="StudentManagementSystem.StudentMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>UniTrack</title>
    <link href="/Styles/output.css?v=2" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.7.2/css/all.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100..900&display=swap" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="NavigationBar" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="bg-white font-roboto">
    <form id="form1" runat="server">
        <div class="fixed top-0 left-0 flex flex-col w-70 h-screen bg-white shadow-lg">

            <div class="mt-4">
                <div class="flex items-center p-6 border-b border-gray-100">
                    <div class="w-12 h-12 min-w-[48px] min-h-[48px] max-w-[48px] max-h-[48px] rounded-full border border-gray-200 overflow-hidden bg-gray-100 flex-shrink-0">
                        <asp:Image ID="ProfilePicture" runat="server" CssClass="w-full h-full object-cover" />
                    </div>
                    <div class="ml-4 overflow-hidden">
                        <p class="text-xs text-gray-400 font-medium tracking-wide uppercase">Student</p>
                        <asp:Label ID="lblStudentName" runat="server" CssClass="text-sm font-bold text-gray-800 block truncate max-w-[150px]"></asp:Label>
                        <a href="/Student/StudentProfile/StudentProfile.aspx" class="text-gray-500 hover:text-indigo-600 transition ml-2 flex-shrink-0">
                            <i class="fa-solid fa-angle-down cursor-pointer"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-2 p-4 text-[18px]">
                <a id="lnkDashboard" runat="server" href="/Student/StudentDashboard/StudentDashboard.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-house"></i><span>Dashboard</span>
                </a>
                <a id="lnkCourse" runat="server" href="/Student/StudentCourse/StudentCourse.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-graduation-cap"></i><span>My Courses</span>
                </a>
                <a id="lnkAcademic" runat="server" href="/Student/StudentAcademicResult/StudentAcademicResult.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-book-open"></i><span>Academic Results</span>
                </a>
                <a id="lnkAnnouncement" runat="server" href="/Student/StudentAnnoucement/StudentAnnoucement.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-bullhorn"></i><span>Announcements</span>
                </a>
                <a id="lnkEnrollment" runat="server" href="/Student/StudentCourseEnrol/StudentCourseEnrol.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-book-open"></i><span>Course Enrollment</span>
                </a>

            </div>

            <div class="mt-auto p-4 mb-2 text-[18px]">
                <a href="/Login.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-red hover:text-white transition">
                    <i class="fa-solid fa-right-from-bracket"></i><span>Log out</span>
                </a>
                <a id="lnkContact" runat="server" href="/ContactAdmin.aspx" class="flex items-center gap-4 px-4 py-2 rounded-md text-black hover:bg-main-color hover:text-white transition">
                    <i class="fa-solid fa-envelope"></i><span>Contact Admin</span>
                </a>
            </div>
        </div>

        <div class="ml-70">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
